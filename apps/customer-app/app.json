{
  "expo": {
    "name": "CustomerApp",
    "slug": "@store-credit-platform/customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "@store-credit-platform/customer-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joshuaasare.-store-credit-platform-customer-app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We use your photo library to let you pick a profile photo.",
        "NSCameraUsageDescription": "We use your camera to let you take a profile photo.",
        "NSLocationWhenInUseUsageDescription": "We use your location to set your home area so we can show you nearby merchant branches."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.joshuaasare.storecreditplatformcustomerapp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-image-picker",
      "expo-location"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      },
      "apiBaseUrl": ""
    }
  }
}
